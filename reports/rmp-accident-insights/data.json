 "limitations": [
  {
   "doc": "docs/trend.md",
   "lead": "Late years are under-observed.",
   "text": "An accident is on file only if a later RMP submission lists it within its five-year history. Facilities whose last submission was before an accident never show it, yet are counted as observed to 2024 if still marked active, or to their last submission year otherwise. This biases recent-year rates downward, and part or all of the decline, especially in 2022-2024, may come from it. The sensitivity set limits the problem for facilities with a 2024 or later submission, but it keeps only survivors still filing, which is itself selective, and it still shows a decline. Neither set removes the bias.",
   "topic": "Recent years are under-observed"
  },
  {
   "doc": "docs/severity.md",
   "lead": "RMP-covered facilities only.",
   "text": "The records are for facilities that file an RMP and hold a regulated substance above its threshold. Accidents at other plants, or involving unlisted substances, are absent.",
   "topic": "RMP-covered facilities only"
  },
  {
   "doc": "docs/severity.md",
   "lead": "Not done.",
   "text": "No dollar-weighted damage analysis (damage is used only as zero or above zero), no cut by initiating event beyond the contributing-cause flags above (the data has no separate initiating-event field), no accident narratives, and no check against the current EPA RMP*Info database.",
   "topic": "No initiating-event field"
  },
  {
   "doc": "docs/severity.md",
   "lead": "Reporting thresholds.",
   "text": "Only accidents that meet EPA's five-year-history criteria (40 CFR 68.42) are on file: a listed substance released with at least one of deaths, injuries, significant property damage, or known offsite consequences such as evacuation, sheltering, or environmental damage. Because many records qualify through an injury, the injury share is high by construction. It must not be read as the chance that an RMP-covered release injures someone, and the data holds no minor releases.",
   "topic": "Only reportable accidents are on file"
  }
 ],
